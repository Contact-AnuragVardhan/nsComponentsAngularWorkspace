{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ns-components-angular": {
      "projectType": "library",
      "schematics":{
        "@schematics/angular:component": {
          "standalone": false
        }
      },
      "root": "projects/ns-components-angular",
      "sourceRoot": "projects/ns-components-angular/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/ns-components-angular/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ns-components-angular/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ns-components-angular/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/ns-components-angular/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
    "ns-components-angular-demo": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/ns-components-angular-demo",
      "sourceRoot": "projects/ns-components-angular-demo/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/ns-components-angular-demo",
            "index": "projects/ns-components-angular-demo/src/index.html",
            "browser": "projects/ns-components-angular-demo/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/ns-components-angular-demo/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/ns-components-angular-demo/public"
              }
            ],
            "styles": [
              "projects/ns-components-angular-demo/src/external/css/nmComponent.css",
              "projects/ns-components-angular-demo/src/external/css/nmComponentBlack.css",
              "projects/ns-components-angular-demo/src/external/css/nmComponentWhite.css",
              "projects/ns-components-angular-demo/src/external/css/app.css",
              "bootstrap/dist/css/bootstrap.css",
              "font-awesome/css/font-awesome.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ns-components-angular-demo:build:production"
            },
            "development": {
              "buildTarget": "ns-components-angular-demo:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/ns-components-angular-demo/tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/ns-components-angular-demo/public"
              }
            ],
            "styles": [
              "projects/ns-components-angular-demo/src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    }
  }
}
